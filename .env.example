# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# ID de la hoja de cálculo de Google que contiene la tabla "Clientes".
# Es el segmento largo de la URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit
SPREADSHEET_ID=

# Rango a leer (opcional, por defecto "Clientes!A:J")
CLIENTS_RANGE=Clientes!A:J

# Credenciales de la cuenta de servicio de Google Cloud, como JSON en una sola línea.
# Se obtiene en IAM & Admin > Service Accounts > Keys > Add key (JSON).
# La cuenta de servicio debe tener acceso de lectura a la hoja.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
